<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast DDS profile: UDPv4 only (disable shared-memory transport). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemaInfo">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_transport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_profile" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>udp_transport</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
